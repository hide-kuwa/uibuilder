{
  "name": "uibuilder",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "pnpm -C web dev",
    "build": "pnpm -C web build",
    "start": "pnpm -C web start",
    "dev:libs": "pnpm -r --filter @chizu/* dev",
    "dev:all": "pnpm -r --parallel --filter @chizu/* --filter preview --filter builder dev",
    "build:all": "pnpm -r --filter @chizu/* build",
    "typecheck:all": "pnpm -r --filter @chizu/* typecheck",
    "lint:all": "pnpm -r lint",
    "test:all": "pnpm -r test",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "gen:component-meta": "ts-node scripts/gen-component-meta.ts --root ./src/components --out ./public/component-meta.json",
    "test": "npm install --no-save --prefix .tmp jest ts-jest @testing-library/react @testing-library/jest-dom react-test-renderer @types/jest jest-environment-jsdom > /dev/null && NODE_PATH=\"$(pwd)/.tmp/node_modules\" node .tmp/node_modules/jest/bin/jest.js --config jest.config.cjs --coverage",
    "run:prompts": "node scripts/run-prompts.mjs",
    "meta": "ts-node scripts/generate-meta.ts",
    "gen:meta": "ts-node scripts/extract-props.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:ci": "E2E_BUILD=1 playwright test -c e2e/playwright.config.ts",
    "codemod:href": "jscodeshift -t codemods/fix-next-dynamic-href.ts web",
    "routes:gen": "ts-node --project tsconfig.json scripts/gen_route_helpers.ts",
    "routes:check": "ts-node --project tsconfig.json scripts/check_dynamic_hrefs.ts",
    "prebuild": "pnpm routes:gen && pnpm routes:check",
    "export:pages": "ts-node scripts/export-pages.ts"
  },
  "bin": {
    "json2tsx": "./scripts/json2tsx.js"
  },
  "dependencies": {
    "@babel/generator": "^7.28.3",
    "@babel/types": "^7.28.2",
    "@codemirror/lang-json": "6.0.0",
    "@dnd-kit/core": "^6.0.8",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-accordion": "1.1.2",
    "@radix-ui/react-tooltip": "^1.2.8",

    
    
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-query-devtools": "^5.85.5",
    "@uiw/react-codemirror": "4.25.1",
    "immer": "10.0.0",
    "prettier": "^3.6.2",
    "react": "18.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-day-picker": "^9.9.0",
    "react-docgen-typescript": "^2.2.2",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.62.0",
    "react-window": "^1.8.9",
    "sharp": "^0.33.5",
    "ts-morph": "^22.0.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "vitest": "^2.1.4",
    "@playwright/test": "^1.47.0",
    "@types/react": "^18.2.47",
    "jscodeshift": "^0.15.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.4.0"
  }
}
