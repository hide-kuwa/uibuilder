{
    "name":  "uibuilder",
    "version":  "1.0.0",
    "type":  "commonjs",
    "scripts":  {
                    "dev":  "pnpm -C web dev",
                    "build":  "pnpm -C web build",
                    "start":  "pnpm -C web start",
                    "dev:libs":  "pnpm -r --filter @chizu/* dev",
                    "dev:all":  "pnpm -r --parallel --filter @chizu/* --filter preview --filter builder dev",
                    "build:all":  "pnpm -r --filter @chizu/* build",
                    "typecheck:all":  "pnpm -r --filter @chizu/* typecheck",
                    "test:e2e:serve":  "cross-env NEXT_PUBLIC_E2E=1 powershell -NoProfile -Command \"$proc = Start-Process -PassThru pnpm -ArgumentList \u0027--filter\u0027,\u0027./web\u0027,\u0027dev\u0027; try { $i=0; while ($i -lt 90) { try { (Invoke-WebRequest -Uri \u0027http://localhost:3000\u0027 -UseBasicParsing -TimeoutSec 2) \u003e $null; break } catch {}; Start-Sleep -Seconds 1; $i++ }; pnpm run test:e2e } finally { if (!$proc.HasExited) { try { $proc.CloseMainWindow() | Out-Null } catch {}; try { Stop-Process -Id $proc.Id -Force } catch {} } }\"",
                    "lint:all":  "pnpm -r lint",
                    "test:all":  "pnpm -r test",
                    "dev:web":  "pnpm --filter ./web dev",
                    "build:web":  "pnpm --filter web build",
                    "gen:component-meta":  "ts-node scripts/gen-component-meta.ts --root ./src/components --out ./public/component-meta.json",
                    "test":  "pnpm run test:unit \u0026\u0026 pnpm run test:e2e",
                    "test:report":  "playwright show-report",
                    "test:unit:watch":  "vitest --watch",
                    "test:ci":  "pnpm -w run test:unit \u0026\u0026 pnpm -w run test:e2e",
                    "run:prompts":  "node scripts/run-prompts.mjs",
                    "meta":  "ts-node scripts/generate-meta.ts",
                    "gen:meta":  "ts-node scripts/extract-props.ts",
                    "e2e":  "playwright test -c e2e/playwright.config.ts",
                    "e2e:builder":  "playwright test apps/builder/e2e --project=chromium",
                    "test:unit":  "vitest run",
                    "test:watch":  "vitest apps/builder/lib/guide/color.spec.ts apps/builder/lib/utils/deepGet.spec.ts",
                    "test:e2e":  "cross-env NEXT_PUBLIC_E2E=1 playwright test -c e2e/playwright.config.ts apps/builder/e2e --project=chromium",
                    "ci:smoke":  "pnpm -F builder dev \u0026 sleep 4 \u0026\u0026 pnpm e2e:builder",
                    "ci:unit":  "pnpm test:unit",
                    "ci:check":  "pnpm ci:unit \u0026\u0026 pnpm ci:smoke",
                    "e2e:ci":  "E2E_BUILD=1 playwright test -c e2e/playwright.config.ts",
                    "codemod:href":  "jscodeshift -t codemods/fix-next-dynamic-href.ts web",
                    "routes:gen":  "ts-node --project tsconfig.json scripts/gen_route_helpers.ts",
                    "routes:check":  "ts-node --project tsconfig.json scripts/check_dynamic_hrefs.ts",
                    "prebuild":  "pnpm routes:gen \u0026\u0026 pnpm routes:check",
                    "export:pages":  "ts-node scripts/export-pages.ts",
                    "perf:baseline:stdin":  "node scripts/ci/append-p95-from-stdin.mjs",
                    "test:web":  "vitest -w --config web/vitest.config.ts"
                },
    "bin":  {
                "json2tsx":  "./scripts/json2tsx.js"
            },
    "dependencies":  {
                         "@babel/generator":  "^7.28.3",
                         "@babel/types":  "^7.28.2",
                         "@codemirror/lang-json":  "6.0.0",
                         "@dnd-kit/core":  "^6.0.8",
                         "@dnd-kit/sortable":  "^8.0.0",
                         "@dnd-kit/utilities":  "^3.2.2",
                         "@hookform/resolvers":  "^5.2.1",
                         "@radix-ui/react-accordion":  "1.1.2",
                         "@radix-ui/react-popover":  "^1.1.15",
                         "@radix-ui/react-tooltip":  "^1.2.8",
                         "@tanstack/react-query":  "^5.85.5",
                         "@tanstack/react-query-devtools":  "^5.85.5",
                         "@uiw/react-codemirror":  "4.25.1",
                         "immer":  "10.0.0",
                         "prettier":  "^3.6.2",
                         "react":  "18.2.0",
                         "react-beautiful-dnd":  "^13.1.1",
                         "react-day-picker":  "^9.9.0",
                         "react-docgen-typescript":  "^2.2.2",
                         "react-dom":  "18.2.0",
                         "react-hook-form":  "^7.62.0",
                         "react-window":  "^1.8.9",
                         "sharp":  "^0.33.5",
                         "ts-morph":  "^22.0.0",
                         "zod":  "^3.23.8",
                         "zustand":  "^4.5.2"
                     },
    "devDependencies":  {
                            "@playwright/test":  "^1.48.0",
                            "@types/node":  "^22.7.4",
                            "@types/react":  "^18.2.47",
                            "cross-env":  "^10.0.0",
                            "glob":  "^11.0.3",
                            "jscodeshift":  "^0.15.2",
                            "jsdom":  "^27.0.0",
                            "start-server-and-test":  "^2.1.0",
                            "ts-node":  "^10.9.1",
                            "tsup":  "^8.5.0",
                            "typescript":  "^5.4.0",
                            "vitest":  "^2.0.0"
                        }
}
