{
  "name": "@chizu/registry",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "components/*": [
        "dist/components/*"
      ],
      "*": [
        "dist/*"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "dependencies": {
    "@chizu/types": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "build:subpaths": "tsup src/index.ts src/components/BacklinkList.tsx src/components/NodeInspector.tsx src/components/GridSheet.tsx src/components/GridSheetV2.tsx --dts --format esm,cjs --outDir dist",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit"
  },
  "devDependencies": {
    "react": "^18.3.1"
  }
}
