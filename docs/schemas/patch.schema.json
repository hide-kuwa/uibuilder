{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DocPatch",
  "type": "object",
  "required": ["docId", "ts", "clientId", "ops"],
  "properties": {
    "docId": { "type": "string" },
    "ts": { "type": "string", "format": "date-time" },
    "clientId": { "type": "string" },
    "ops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "path"],
        "properties": {
          "type": { "type": "string", "enum": ["set", "remove", "insert", "move"] },
          "path": { "type": "string" },
          "value": {},
          "from": { "type": "string" },
          "index": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
