// 窶ｻ 'use client' 縺ｯ邨ｶ蟇ｾ縺ｫ鄂ｮ縺九↑縺・ｼ・ayout縺ｯ繧ｵ繝ｼ繝舌・繧ｳ繝ｳ繝昴・繝阪Φ繝茨ｼ・
import type { ReactNode } from 'react'
import { cookies } from 'next/headers'
import Providers from './providers' // 竊・縺薙ｌ縺ｯ client 縺ｧ繧０K

export default async function RootLayout({ children }: { children: ReactNode }) {
  // 笨・縺薙％繧・await 縺ｫ縺吶ｋ
  const cookieStore = await cookies()
  const uiTheme = cookieStore.get('ui-theme')?.value ?? 'light'

  return (
    <html lang="ja" data-theme={uiTheme} suppressHydrationWarning>
      <body>
        {/* client 蛛ｴ縺ｧ菴ｿ縺・◆縺代ｌ縺ｰ蛻晄悄蛟､縺ｨ縺励※貂｡縺・*/}
        <Providers initialTheme={uiTheme}>{children}</Providers>
      </body>
    </html>
  )
}

