rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isApprovedFollower(ownerUid) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(ownerUid)/followers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(ownerUid)/followers/$(request.auth.uid)).data.status == 'approved';
    }

    match /users/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid);

      match /maps/{mapId} {
        allow read: if resource.data.visibility == 'public'
                     || (resource.data.visibility == 'followers' && isApprovedFollower(uid))
                     || isOwner(uid);
        allow create, update, delete: if isOwner(uid);

        match /photos/{photoId} {
          allow read: if
            get(/databases/$(database)/documents/users/$(uid)/maps/$(mapId)).data.visibility == 'public'
            || (get(/databases/$(database)/documents/users/$(uid)/maps/$(mapId)).data.visibility == 'followers' && isApprovedFollower(uid))
            || isOwner(uid);
          allow create, update, delete: if isOwner(uid);
        }
      }

      match /followers/{followerUid} {
        allow create: if isSignedIn() && followerUid == request.auth.uid && request.resource.data.status == 'requested';
        allow update: if isOwner(uid);
        allow read:   if isOwner(uid) || (isSignedIn() && followerUid == request.auth.uid);
        allow delete: if isOwner(uid) || (isSignedIn() && followerUid == request.auth.uid);
      }
    }
  }
}
