{
  "extends": ["next/core-web-vitals"],
  "rules": {
    "max-lines": ["warn", { "max": 400, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": ["warn", { "max": 120, "skipBlankLines": true, "skipComments": true, "IIFEs": true }],
    "complexity": ["warn", { "max": 12 }],
    "max-depth": ["warn", 4],
    "max-params": ["warn", 6]
  }
}
